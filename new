#!/usr/bin/env python3
import os
import re
import csv
import sys

# ----------------------------
# Usage and arguments
# ----------------------------
if len(sys.argv) != 3:
    print("Usage: python3 check_cells.py <path_to_cells> <cell_list_file | -all>")
    sys.exit(1)

base_dir = sys.argv[1]
cell_list_arg = sys.argv[2]

if not os.path.isdir(base_dir):
    print(f"Error: directory {base_dir} does not exist.")
    sys.exit(1)

# ----------------------------
# Cell list
# ----------------------------
if cell_list_arg.lower() == "-all":
    cell_list = [d for d in os.listdir(base_dir) if os.path.isdir(os.path.join(base_dir, d))]
else:
    if not os.path.isfile(cell_list_arg):
        print(f"Error: cell list file {cell_list_arg} not found.")
        sys.exit(1)
    with open(cell_list_arg, 'r') as f:
        cell_list = [line.strip() for line in f if line.strip()]

# ----------------------------
# Arguments to check
# ----------------------------
# Base arguments (DiffAreas and GateAreas excluded initially)
common_args = [
    "ArchkRunDate", "CellArea", "CellHeight", "CellHeightGrids",
    "CellWidth", "CellWidthGrids", "GDSCellName",
    "LefGeneration", "NumTransistors", "RawGateDensity",
    "TransistorsPerGrid", "pin_V"
]

# DiffAreas and GateAreas normally required except fill cells
diff_gate_args = ["DiffAreas", "GateAreas"]

# Extra arguments for fs/fd/fr/sync cells
extra_args = ["IntNode_", "NoCKSkew_", "NACKSkew_"]

# Patterns
fill_pattern = re.compile(r'^(fill_|filld_)|(_fill_|_filld_)', re.IGNORECASE)
special_pattern = re.compile(r'^(fs|fd|fr|sync)|(_fs|_fd|_fr|_sync)', re.IGNORECASE)

# ----------------------------
# Check each cell
# ----------------------------
results = {}

for cell_name in cell_list:
    cell_path = os.path.join(base_dir, cell_name)
    info_file = os.path.join(cell_path, f"{cell_name}.info")

    if not os.path.isdir(cell_path):
        results[cell_name] = {'file': None, 'missing': ['Cell directory not found']}
        continue

    if not os.path.isfile(info_file):
        results[cell_name] = {'file': None, 'missing': ['Info file not found']}
        continue

    with open(info_file, 'r', errors='ignore') as f:
        content = f.read()

    # Determine which arguments to check
    args_to_check = list(common_args)

    # Add DiffAreas and GateAreas unless fill-pattern matches
    if not fill_pattern.search(cell_name):
        args_to_check += diff_gate_args

    # Add IntNode_, NoCKSkew_, NACKSkew_ if special-pattern matches
    if special_pattern.search(cell_name):
        args_to_check += extra_args

    # Find missing arguments
    missing = [arg for arg in args_to_check if arg not in content]

    results[cell_name] = {'file': info_file, 'missing': missing}

# ----------------------------
# Summaries
# ----------------------------
cells_missing_info = [c for c, d in results.items() if d['file'] is None and 'Info file not found' in d['missing']]
cells_missing_args = [c for c, d in results.items() if d['file'] and d['missing']]
cells_passed = [c for c, d in results.items() if d['file'] and not d['missing']]

# Count missing arguments across all failed cells
total_missing_args = sum(len(results[c]['missing']) for c in cells_missing_args)

# ----------------------------
# Write CSV report
# ----------------------------
report_file = os.path.join(os.path.dirname(base_dir), "cell_check_report.csv")
with open(report_file, 'w', newline='') as csvfile:
    fieldnames = ['Cell', 'Info File', 'Missing Arguments']
    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
    writer.writeheader()

    for cell, data in sorted(results.items()):
        missing_str = ', '.join(data['missing']) if data['missing'] else 'None'
        writer.writerow({
            'Cell': cell,
            'Info File': data['file'] if data['file'] else 'Not found',
            'Missing Arguments': missing_str
        })

    # Add summary as last row
    if cells_missing_args or cells_missing_info:
        writer.writerow({'Cell': 'SUMMARY', 'Info File': '',
                         'Missing Arguments': f"Failed cells missing args: {len(cells_missing_args)} | "
                                              f"Failed cells missing info: {len(cells_missing_info)}"})
    else:
        writer.writerow({'Cell': 'SUMMARY', 'Info File': '', 'Missing Arguments': "All cells Passed"})

# ----------------------------
# Print results to console
# ----------------------------
for cell, data in sorted(results.items()):
    print(f"\nCell: {cell}")
    if data['file']:
        print(f"  Info file: {data['file']}")
        if data['missing']:
            print(f"  Missing arguments: {', '.join(data['missing'])}")
        else:
            print("  All required arguments present.")
    else:
        print(f"  {', '.join(data['missing'])}")

# ----------------------------
# Pretty summary block
# ----------------------------
summary_block = "\n" + "=" * 60 + "\nSUMMARY:\n"
if cells_missing_args:
    summary_block += f"Failed cells were missing arguments – {len(cells_missing_args)} cell\n"
if cells_missing_info:
    summary_block += f"Failed cells were missing info files – {len(cells_missing_info)} cell\n"
if not cells_missing_args and not cells_missing_info:
    summary_block += "All cells Passed\n"

summary_block += f"Report file created: {report_file}\n"
summary_block += f"Report file created: {report_file}\n"
summary_block += "=" * 60
print(summary_block)